#: src/globalPlugins/easyAudioConverter/__init__.py:4389
msgid "The conversion will stop after the current file"
msgstr "നിലവിലെ ഫയലിന് ശേഷം പരിവർത്തനം നിർത്തും"

#: src/globalPlugins/easyAudioConverter/__init__.py:2025
msgid "The file does not contain valid conversion profiles."
msgstr "ഫയലിൽ സാധുതയുള്ള പരിവർത്തന പ്രൊഫൈലുകൾ അടങ്ങിയിട്ടില്ല."

#: src/globalPlugins/easyAudioConverter/__init__.py:423
msgid "The first AAC audio stream will be remuxed into M4A without re-encoding. Sources whose first audio stream is not AAC are skipped."
msgstr "ആദ്യത്തെ AAC ഓഡിയോ സ്ട്രീം വീണ്ടും എൻകോഡിംഗ് ഇല്ലാതെ M4A ലേക്ക് പുനർനിർമ്മിക്കും. ആദ്യത്തെ ഓഡിയോ സ്ട്രീം AAC അല്ലാത്ത സ്രോതസ്സുകൾ ഒഴിവാക്കുന്നു."

#: src/globalPlugins/easyAudioConverter/__init__.py:2756
msgid "The first audio stream is not AAC, so it cannot be remuxed to M4A"
msgstr "ആദ്യത്തെ ഓഡിയോ സ്ട്രീം AAC അല്ല, അതിനാൽ ഇത് M4A ലേക്ക് റീമക്സ് ചെയ്യാൻ കഴിയില്ല"

#: src/globalPlugins/easyAudioConverter/__init__.py:417
msgid "The first audio stream will be extracted without re-encoding. Its codec and quality remain unchanged, and the output extension is selected automatically."
msgstr "ആദ്യത്തെ ഓഡിയോ സ്ട്രീം വീണ്ടും എൻകോഡിംഗ് ഇല്ലാതെ എക്സ്ട്രാക്റ്റ് ചെയ്യും. അതിന്റെ കോഡെക്കും ഗുണനിലവാരവും മാറ്റമില്ലാതെ തുടരുന്നു, കൂടാതെ ഔട്ട്പുട്ട് എക്സ്റ്റൻഷൻ യാന്ത്രികമായി തിരഞ്ഞെടുക്കപ്പെടുന്നു."

#: src/globalPlugins/easyAudioConverter/__init__.py:2742
msgid "The input does not contain a readable audio stream."
msgstr "ഇൻപുട്ടിൽ വായിക്കാവുന്ന ഓഡിയോ സ്ട്രീം അടങ്ങിയിട്ടില്ല."

#: src/globalPlugins/easyAudioConverter/__init__.py:2740
msgid "The input file is damaged or uses an unsupported encoding."
msgstr "ഇൻപുട്ട് ഫയലിന് കേടുപാടുകൾ സംഭവിച്ചിരിക്കുന്നു അല്ലെങ്കിൽ പിന്തുണയ്ക്കാത്ത എൻകോഡിംഗ് ഉപയോഗിക്കുന്നു."

#: src/globalPlugins/easyAudioConverter/__init__.py:2775
msgid "The job was stopped after the current file."
msgstr "നിലവിലെ ഫയലിന് ശേഷം ജോലി നിർത്തി."

