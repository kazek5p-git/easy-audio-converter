msgstr "ആദ്യത്തെ ഓഡിയോ സ്ട്രീം AAC അല്ല, അതിനാൽ ഇത് M4A ലേക്ക് റീമക്സ് ചെയ്യാൻ കഴിയില്ല"

#: src/globalPlugins/easyAudioConverter/__init__.py:412
msgid "The first audio stream will be extracted without re-encoding. Its codec and quality remain unchanged, and the output extension is selected automatically."
msgstr "ആദ്യത്തെ ഓഡിയോ സ്ട്രീം വീണ്ടും എൻകോഡിംഗ് ഇല്ലാതെ എക്സ്ട്രാക്റ്റ് ചെയ്യും. അതിന്റെ കോഡെക്കും ഗുണനിലവാരവും മാറ്റമില്ലാതെ തുടരുന്നു, കൂടാതെ ഔട്ട്പുട്ട് എക്സ്റ്റൻഷൻ യാന്ത്രികമായി തിരഞ്ഞെടുക്കപ്പെടുന്നു."

#: src/globalPlugins/easyAudioConverter/__init__.py:2583
msgid "The input does not contain a readable audio stream."
msgstr "ഇൻപുട്ടിൽ വായിക്കാവുന്ന ഓഡിയോ സ്ട്രീം അടങ്ങിയിട്ടില്ല."

#: src/globalPlugins/easyAudioConverter/__init__.py:2581
msgid "The input file is damaged or uses an unsupported encoding."
msgstr "ഇൻപുട്ട് ഫയലിന് കേടുപാടുകൾ സംഭവിച്ചിരിക്കുന്നു അല്ലെങ്കിൽ പിന്തുണയ്ക്കാത്ത എൻകോഡിംഗ് ഉപയോഗിക്കുന്നു."

#: src/globalPlugins/easyAudioConverter/__init__.py:2614
msgid "The job was stopped after the current file."
msgstr "നിലവിലെ ഫയലിന് ശേഷം ജോലി നിർത്തി."

#: src/globalPlugins/easyAudioConverter/__init__.py:1850
msgid "The profile file is too large."
msgstr "പ്രൊഫൈൽ ഫയൽ വളരെ വലുതാണ്."

#: src/globalPlugins/easyAudioConverter/__init__.py:1947
msgid "The profile name cannot be empty."
msgstr "പ്രൊഫൈൽ പേര് ശൂന്യമായി വിടാൻ പാടില്ല."

#: src/globalPlugins/easyAudioConverter/__init__.py:3243
msgid "The update could not be downloaded or verified.\n\n{error}"
msgstr "അപ് ഡേറ്റ് ഡൗൺലോഡ് ചെയ്യാനോ പരിശോധിച്ചുറപ്പിക്കാനോ കഴിഞ്ഞില്ല.\n\n{error}"

#: src/globalPlugins/easyAudioConverter/__init__.py:3251
msgid "The update is ready. Opening the NVDA add-on installer."
msgstr "അപ് ഡേറ്റ് തയ്യാറായി. NVDA ആഡ്-ഓൺ ഇൻസ്റ്റാളർ തുറക്കുന്നു."

#: src/globalPlugins/easyAudioConverter/__init__.py:1885
msgid "There are no user profiles to export"
msgstr "എക്സ്പോർട്ട് ചെയ്യാൻ ഉപയോക്തൃ പ്രൊഫൈലുകൾ ഇല്ല"

#: src/globalPlugins/easyAudioConverter/__init__.py:2579
