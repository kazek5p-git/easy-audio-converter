msgstr "ਪਰਿਵਰਤਨ ਕਤਾਰ ਖਾਲੀ ਹੈ"

#: src/globalPlugins/easyAudioConverter/__init__.py:2874
msgid "The conversion was canceled."
msgstr "ਪਰਿਵਰਤਨ ਰੱਦ ਕਰ ਦਿੱਤਾ ਗਿਆ ਸੀ।"

#: src/globalPlugins/easyAudioConverter/__init__.py:4523
msgid "The conversion will stop after the current file"
msgstr "ਵਰਤਮਾਨ ਫ਼ਾਈਲ ਤੋਂ ਬਾਅਦ ਰੂਪਾਂਤਰਣ ਬੰਦ ਹੋ ਜਾਵੇਗਾ"

#: src/globalPlugins/easyAudioConverter/__init__.py:2833
msgid "The converted output was kept, but the source file could not be removed."
msgstr "ਪਰਿਵਰਤਿਤ ਆਉਟਪੁੱਟ ਨੂੰ ਰੱਖਿਆ ਗਿਆ ਸੀ, ਪਰ ਸਰੋਤ ਫਾਈਲ ਨੂੰ ਹਟਾਇਆ ਨਹੀਂ ਜਾ ਸਕਿਆ।"

#: src/globalPlugins/easyAudioConverter/__init__.py:2107
msgid "The file does not contain valid conversion profiles."
msgstr "ਫ਼ਾਈਲ ਵਿੱਚ ਵੈਧ ਪਰਿਵਰਤਨ ਪ੍ਰੋਫ਼ਾਈਲ ਨਹੀਂ ਹਨ।"

#: src/globalPlugins/easyAudioConverter/__init__.py:446
msgid "The first AAC audio stream will be remuxed into M4A without re-encoding. Sources whose first audio stream is not AAC are skipped."
msgstr "ਪਹਿਲੀ ਏਏਸੀ ਆਡੀਓ ਸਟ੍ਰੀਮ ਨੂੰ ਦੁਬਾਰਾ ਏਨਕੋਡਿੰਗ ਤੋਂ ਬਿਨਾਂ ਐਮ4ਏ ਵਿੱਚ ਦੁਬਾਰਾ ਪੇਸ਼ ਕੀਤਾ ਜਾਵੇਗਾ. ਉਹ ਸਰੋਤ ਜਿਨ੍ਹਾਂ ਦੀ ਪਹਿਲੀ ਆਡੀਓ ਸਟ੍ਰੀਮ ਏਏਸੀ ਨਹੀਂ ਹੈ, ਨੂੰ ਛੱਡ ਦਿੱਤਾ ਜਾਂਦਾ ਹੈ।"

#: src/globalPlugins/easyAudioConverter/__init__.py:2857
msgid "The first audio stream is not AAC, so it cannot be remuxed to M4A"
msgstr "ਪਹਿਲੀ ਆਡੀਓ ਸਟ੍ਰੀਮ ਏਏਸੀ ਨਹੀਂ ਹੈ, ਇਸ ਲਈ ਇਸ ਨੂੰ ਐਮ4ਏ ਵਿੱਚ ਦੁਬਾਰਾ ਨਹੀਂ ਭੇਜਿਆ ਜਾ ਸਕਦਾ"

#: src/globalPlugins/easyAudioConverter/__init__.py:440
msgid "The first audio stream will be extracted without re-encoding. Its codec and quality remain unchanged, and the output extension is selected automatically."
msgstr "ਪਹਿਲੀ ਆਡੀਓ ਸਟ੍ਰੀਮ ਨੂੰ ਮੁੜ-ਏਨਕੋਡਿੰਗ ਤੋਂ ਬਿਨਾਂ ਐਕਸਟਰੈਕਟ ਕੀਤਾ ਜਾਵੇਗਾ। ਇਸ ਦਾ ਕੋਡੈੱਕ ਅਤੇ ਕੁਆਲਿਟੀ ਵਿੱਚ ਕੋਈ ਤਬਦੀਲੀ ਨਹੀਂ ਕੀਤੀ ਜਾਂਦੀ ਹੈ, ਅਤੇ ਆਉਟਪੁੱਟ ਐਕਸਟੈਂਸ਼ਨ ਆਪਣੇ ਆਪ ਚੁਣਿਆ ਜਾਂਦਾ ਹੈ।"

#: src/globalPlugins/easyAudioConverter/__init__.py:2843
msgid "The input does not contain a readable audio stream."
msgstr "ਇਨਪੁੱਟ ਵਿੱਚ ਪੜ੍ਹਨਯੋਗ ਆਡੀਓ ਸਟ੍ਰੀਮ ਨਹੀਂ ਹੈ।"

#: src/globalPlugins/easyAudioConverter/__init__.py:2841
msgid "The input file is damaged or uses an unsupported encoding."
msgstr "ਇਨਪੁੱਟ ਫਾਇਲ ਨੁਕਸਾਨੀ ਗਈ ਹੈ ਜਾਂ ਅਸਮਰਥਿਤ ਏਨਕੋਡਿੰਗ ਦੀ ਵਰਤੋਂ ਕਰਦੀ ਹੈ।"

#: src/globalPlugins/easyAudioConverter/__init__.py:2876
msgid "The job was stopped after the current file."
msgstr "ਮੌਜੂਦਾ ਫਾਇਲ ਤੋਂ ਬਾਅਦ ਕੰਮ ਬੰਦ ਕਰ ਦਿੱਤਾ ਗਿਆ ਸੀ।"

#: src/globalPlugins/easyAudioConverter/__init__.py:2091
