msgstr "மாற்று வரிசை காலியாக உள்ளது"

#: src/globalPlugins/easyAudioConverter/__init__.py:3066
msgid "The conversion was canceled."
msgstr "மாற்றம் ரத்து செய்யப்பட்டது."

#: src/globalPlugins/easyAudioConverter/__init__.py:4742
msgid "The conversion will stop after the current file"
msgstr "தற்போதைய கோப்புக்குப் பிறகு மாற்றம் நிறுத்தப்படும்"

#: src/globalPlugins/easyAudioConverter/__init__.py:3025
msgid "The converted output was kept, but the source file could not be removed."
msgstr "மாற்றப்பட்ட வெளியீடு சேமிக்கப்பட்டது, ஆனால் மூலக் கோப்பை அகற்ற முடியவில்லை."

#: src/globalPlugins/easyAudioConverter/__init__.py:2273
msgid "The file does not contain valid conversion profiles."
msgstr "கோப்பில் செல்லுபடியாகும் மாற்று சுயவிவரங்கள் இல்லை."

#: src/globalPlugins/easyAudioConverter/__init__.py:471
msgid "The first AAC audio stream will be remuxed into M4A without re-encoding. Sources whose first audio stream is not AAC are skipped."
msgstr "முதல் AAC ஆடியோ ஸ்ட்ரீம் மறு குறியாக்கம் இல்லாமல் M4A இல் மறுசீரமைக்கப்படும். முதல் ஆடியோ ஸ்ட்ரீம் AAC இல்லாத ஆதாரங்கள் தவிர்க்கப்படுகின்றன."

#: src/globalPlugins/easyAudioConverter/__init__.py:3049
msgid "The first audio stream is not AAC, so it cannot be remuxed to M4A"
msgstr "முதல் ஆடியோ ஸ்ட்ரீம் AAC அல்ல, எனவே அதை M4A க்கு மாற்ற முடியாது"

#: src/globalPlugins/easyAudioConverter/__init__.py:465
msgid "The first audio stream will be extracted without re-encoding. Its codec and quality remain unchanged, and the output extension is selected automatically."
msgstr "முதல் ஆடியோ ஸ்ட்ரீம் மறு குறியாக்கம் இல்லாமல் பிரித்தெடுக்கப்படும். அதன் கோடெக் மற்றும் தரம் மாறாமல் இருக்கும், மேலும் வெளியீட்டு நீட்டிப்பு தானாகவே தேர்ந்தெடுக்கப்படுகிறது."

#: src/globalPlugins/easyAudioConverter/__init__.py:3035
msgid "The input does not contain a readable audio stream."
msgstr "உள்ளீட்டில் படிக்கக்கூடிய ஆடியோ ஸ்ட்ரீம் இல்லை."

#: src/globalPlugins/easyAudioConverter/__init__.py:3033
msgid "The input file is damaged or uses an unsupported encoding."
msgstr "உள்ளீட்டு கோப்பு சேதமடைந்துள்ளது அல்லது ஆதரிக்கப்படாத குறியாக்கத்தை பயன்படுத்துகிறது."

#: src/globalPlugins/easyAudioConverter/__init__.py:3068
msgid "The job was stopped after the current file."
msgstr "நடப்பு கோப்பிற்குப் பிறகு பணி நிறுத்தப்பட்டது."

#: src/globalPlugins/easyAudioConverter/__init__.py:2257
msgid "The profile file is too large."
msgstr "சுயவிவரக் கோப்பு மிகப் பெரியது."

#: src/globalPlugins/easyAudioConverter/__init__.py:2354
msgid "The profile name cannot be empty."
msgstr "சுயவிவரப் பெயர் காலியாக இருக்க முடியாது."

#: src/globalPlugins/easyAudioConverter/__init__.py:3039
msgid "The source file dates could not be preserved."
msgstr "மூல கோப்பு தேதிகளை பாதுகாக்க இயலவில்லை."

