#: src/globalPlugins/easyAudioConverter/__init__.py:440
msgid "The first audio stream will be extracted without re-encoding. Its codec and quality remain unchanged, and the output extension is selected automatically."
msgstr "முதல் ஆடியோ ஸ்ட்ரீம் மறு குறியாக்கம் இல்லாமல் பிரித்தெடுக்கப்படும். அதன் கோடெக் மற்றும் தரம் மாறாமல் இருக்கும், மேலும் வெளியீட்டு நீட்டிப்பு தானாகவே தேர்ந்தெடுக்கப்படுகிறது."

#: src/globalPlugins/easyAudioConverter/__init__.py:2843
msgid "The input does not contain a readable audio stream."
msgstr "உள்ளீட்டில் படிக்கக்கூடிய ஆடியோ ஸ்ட்ரீம் இல்லை."

#: src/globalPlugins/easyAudioConverter/__init__.py:2841
msgid "The input file is damaged or uses an unsupported encoding."
msgstr "உள்ளீட்டு கோப்பு சேதமடைந்துள்ளது அல்லது ஆதரிக்கப்படாத குறியாக்கத்தை பயன்படுத்துகிறது."

#: src/globalPlugins/easyAudioConverter/__init__.py:2876
msgid "The job was stopped after the current file."
msgstr "நடப்பு கோப்பிற்குப் பிறகு பணி நிறுத்தப்பட்டது."

#: src/globalPlugins/easyAudioConverter/__init__.py:2091
msgid "The profile file is too large."
msgstr "சுயவிவரக் கோப்பு மிகப் பெரியது."

#: src/globalPlugins/easyAudioConverter/__init__.py:2188
msgid "The profile name cannot be empty."
msgstr "சுயவிவரப் பெயர் காலியாக இருக்க முடியாது."

#: src/globalPlugins/easyAudioConverter/__init__.py:2847
msgid "The source file dates could not be preserved."
msgstr "மூல கோப்பு தேதிகளை பாதுகாக்க இயலவில்லை."

#: src/globalPlugins/easyAudioConverter/__init__.py:3527
msgid "The update could not be downloaded or verified.\n\n{error}"
msgstr "புதுப்பித்தலை பதிவிறக்கம் செய்யவோ அல்லது சரிபார்க்கவோ இயலாது.\n\n{error}"

#: src/globalPlugins/easyAudioConverter/__init__.py:3535
msgid "The update is ready. Opening the NVDA add-on installer."
msgstr "அப்டேட் தயாராக உள்ளது. NVDA துணை நிரல் நிறுவியைத் திறக்கிறது."

#: src/globalPlugins/easyAudioConverter/__init__.py:2126
msgid "There are no user profiles to export"
msgstr "ஏற்றுமதி செய்ய பயனர் சுயவிவரங்கள் எதுவும் இல்லை"

#: src/globalPlugins/easyAudioConverter/__init__.py:2839
msgid "There is not enough free disk space."
msgstr "போதுமான காலி வட்டு இடம் இல்லை."

#: src/globalPlugins/easyAudioConverter/__init__.py:497
msgid "Title"
msgstr "தலைப்பு"

#: src/globalPlugins/easyAudioConverter/__init__.py:2315
msgid "Total audio duration: {duration}"
msgstr "மொத்த ஆடியோ காலம்: {duration}"

#: src/globalPlugins/easyAudioConverter/__init__.py:504
msgid "Track number"
msgstr "டிராக் எண்"

#: src/globalPlugins/easyAudioConverter/__init__.py:2848 src/globalPlugins/easyAudioConverter/__init__.py:3528 src/globalPlugins/easyAudioConverter/__init__.py:4413 src/globalPlugins/easyAudioConverter/__init__.py:3387
msgid "Unknown error"
msgstr "அறியப்படாத பிழை"

#: src/globalPlugins/easyAudioConverter/__init__.py:2854
msgid "Unsupported file type"
msgstr "ஆதரிக்கப்படாத கோப்பு வகை"

#: src/globalPlugins/easyAudioConverter/__init__.py:3523
msgid "Update download canceled"
msgstr "புதுப்பித்தல் பதிவிறக்கம் ரத்து செய்யப்பட்டது"

#: src/globalPlugins/easyAudioConverter/__init__.py:1163 src/globalPlugins/easyAudioConverter/__init__.py:1185 src/globalPlugins/easyAudioConverter/__init__.py:1256
msgid "Use the quality preset"
msgstr "தர முன்னமைவைப் பயன்படுத்தவும்"

#: src/globalPlugins/easyAudioConverter/__init__.py:1792
msgid "Use these settings for future quick conversions"
msgstr "எதிர்கால விரைவான மாற்றங்களுக்கு இந்த அமைப்புகளைப் பயன்படுத்தவும்"

#: src/globalPlugins/easyAudioConverter/__init__.py:2564
msgid "Verifying the output by decoding it"
msgstr "வெளியீட்டை டிகோடிங் செய்வதன் மூலம் சரிபார்க்கிறது"

#: src/globalPlugins/easyAudioConverter/__init__.py:466
msgid "Very high"
msgstr "மிக உயர்ந்தது"

#: src/globalPlugins/easyAudioConverter/__init__.py:1179
msgid "Very high + extra 1, -hhx1 (FFmpeg level 4)"
msgstr "மிக உயர்ந்த + கூடுதல் 1, -hhx1 (FFmpeg நிலை 4)"

#: src/globalPlugins/easyAudioConverter/__init__.py:1180
msgid "Very high + extra 2, -hhx2 (FFmpeg level 5)"
msgstr "மிக உயர்ந்த + கூடுதல் 2, -hhx2 (FFmpeg நிலை 5)"

#: src/globalPlugins/easyAudioConverter/__init__.py:1181
msgid "Very high + extra 3, -hhx3 (FFmpeg level 6)"
msgstr "மிக உயர்ந்த + கூடுதல் 3, -hhx3 (FFmpeg நிலை 6)"

#: src/globalPlugins/easyAudioConverter/__init__.py:1182
msgid "Very high + extra 4, -hhx4 (FFmpeg level 7)"
msgstr "மிக உயர்ந்த + கூடுதல் 4, -hhx4 (FFmpeg நிலை 7)"

#: src/globalPlugins/easyAudioConverter/__init__.py:1178
msgid "Very high, -hh (FFmpeg level 3)"
msgstr "மிக அதிகம், -hh (FFmpeg நிலை 3)"

#: src/globalPlugins/easyAudioConverter/__init__.py:416
msgid "WAV"
msgstr "WAV"

#: src/globalPlugins/easyAudioConverter/__init__.py:422
msgid "WMA"
msgstr "டபிள்யூ.எம்.ஏ"

#: src/globalPlugins/easyAudioConverter/__init__.py:2325
msgid "Warning: source files will be permanently deleted after successful conversion."
msgstr "எச்சரிக்கை: வெற்றிகரமான மாற்றத்திற்குப் பிறகு மூலக் கோப்புகள் நிரந்தரமாக நீக்கப்படும்."

#: src/globalPlugins/easyAudioConverter/__init__.py:2343
msgid "Warning: the estimated output is larger than the available disk space."
msgstr "எச்சரிக்கை: மதிப்பிடப்பட்ட வெளியீடு கிடைக்கக்கூடிய வட்டு இடத்தை விட பெரியது."

#: src/globalPlugins/easyAudioConverter/__init__.py:2332
msgid "Warning: {count} files will be converted from a lossy format to another lossy format, which can reduce quality."
msgstr "எச்சரிக்கை: {count} கோப்புகள் இழப்பு வடிவத்திலிருந்து மற்றொரு இழப்பு வடிவத்திற்கு மாற்றப்படும், இது தரத்தைக் குறைக்கும்."

#: src/globalPlugins/easyAudioConverter/__init__.py:427
msgid "WavPack"
msgstr "WavPack"

#: src/globalPlugins/easyAudioConverter/__init__.py:1359
msgid "WavPack profiles use FFmpeg levels 0 to 8. Level 8 corresponds to -hhx6 and is extremely slow."
msgstr "WavPack சுயவிவரங்கள் FFmpeg நிலைகளை 0 முதல் 8 வரை பயன்படுத்துகின்றன. நிலை 8 -hhx6 உடன் ஒத்திருக்கிறது மற்றும் மிகவும் மெதுவாக உள்ளது."

