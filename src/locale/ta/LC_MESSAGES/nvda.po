msgstr "மாற்றத்தை தொடங்க முடியவில்லை"

#: src/globalPlugins/easyAudioConverter/__init__.py:4097
msgid "The conversion could not start:\n{error}"
msgstr "மாற்றத்தைத் தொடங்க முடியவில்லை:\n{error}"

#: src/globalPlugins/easyAudioConverter/__init__.py:4766 src/globalPlugins/easyAudioConverter/__init__.py:4757
