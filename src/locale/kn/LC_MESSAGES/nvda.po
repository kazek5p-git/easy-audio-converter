msgid "Total audio duration: {duration}"
msgstr "ಒಟ್ಟು ಆಡಿಯೋ ಅವಧಿ: {duration}"

#: src/globalPlugins/easyAudioConverter/__init__.py:476
msgid "Track number"
msgstr "ಟ್ರ್ಯಾಕ್ ಸಂಖ್ಯೆ"

