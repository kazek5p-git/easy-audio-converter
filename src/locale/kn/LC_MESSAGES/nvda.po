#: src/globalPlugins/easyAudioConverter/__init__.py:1557
msgid "Use these settings for future quick conversions"
msgstr "ಭವಿಷ್ಯದ ತ್ವರಿತ ಪರಿವರ್ತನೆಗಳಿಗಾಗಿ ಈ ಸೆಟ್ಟಿಂಗ್ ಗಳನ್ನು ಬಳಸಿ"

#: src/globalPlugins/easyAudioConverter/__init__.py:2308
msgid "Verifying the output by decoding it"
msgstr "ಡಿಕೋಡ್ ಮಾಡುವ ಮೂಲಕ ಔಟ್‌ಪುಟ್ ಅನ್ನು ಪರಿಶೀಲಿಸಲಾಗುತ್ತಿದೆ"

